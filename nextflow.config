process {
    container     = 'wchen27/stain-norm:0.1.0'
    cpus          = 2
    memory        = { 4.GB * task.attempt }
    time          = { 1.h * task.attempt }
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries    = 1

    withName: SUMMARY {
        cpus          = 1
        errorStrategy = 'terminate'
    }
}

docker.enabled = true

profiles {
    mac {
        docker.runOptions = '--platform linux/amd64'
        executor.cpus     = 4
    }
}
